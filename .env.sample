AWS_ACCESS_KEY_ID=000
AWS_SECRET_ACCESS_KEY=000
AWS_DEFAULT_REGION=us-east-1

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=000
LANGSMITH_PROJECT=mini-pjt

# 아래 값은 모두 필수다. 기본값이 없어서 하나라도 비면 서버가 시작되지 않는다 (LLM: Claude Haiku 4.5, 임베딩: Amazon Titan Text Embeddings v2)
BEDROCK_LLM_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Bedrock 스로틀링 대비 재시도 횟수(0 이상의 정수, 필수)
BEDROCK_MAX_RETRIES=3

# (선택) evaluate.py의 판정 모델. 비워 두면 BEDROCK_LLM_MODEL_ID와 같은 모델이 판정한다(자기 평가 편향 가능)
# BEDROCK_JUDGE_MODEL_ID=
