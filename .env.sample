AWS_ACCESS_KEY_ID=000
AWS_SECRET_ACCESS_KEY=000
AWS_DEFAULT_REGION=us-east-1

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=000
LANGSMITH_PROJECT=desk-simulator

# 아래 값은 모두 필수다. 기본값이 없어서 하나라도 비면 서버가 시작되지 않는다 (LLM: Claude Haiku 4.5)
BEDROCK_LLM_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock 스로틀링 대비 재시도 횟수(0 이상의 정수, 필수)
BEDROCK_MAX_RETRIES=3

# (선택) 가이드 문서 검색(RAG)의 임베딩 모델. 비워 두면 벡터 검색 없이 키워드(BM25) 검색만 한다
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# (선택) 상품 검색: 네이버 개발자센터(developers.naver.com)에서 애플리케이션을 등록하고 '검색' API를 고르면 받는 키.
# 비워 두면 상품 목록 없이 치수에 맞춘 네이버 쇼핑 검색 링크만 보여 준다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (선택) 평가(src/evaluate.py)의 판정 모델. 비워 두면 BEDROCK_LLM_MODEL_ID와 같은 모델이 판정한다(자기 평가 편향 가능)
# BEDROCK_JUDGE_MODEL_ID=
